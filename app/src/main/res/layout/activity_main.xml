            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp">
                <TextView android:text="Credencial digital oficial" android:textColor="#B9C7E6" android:textSize="11sp" android:letterSpacing=".06" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <TextView android:text="Vigente" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp" android:drawableStart="@drawable/dot_green" android:drawablePadding="6dp" android:gravity="center_vertical" android:background="@drawable/chip_glass" android:paddingStart="10dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
            <LinearLayout android:id="@+id/cardReverso" android:visibility="invisible" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="20dp" android:background="@drawable/bg_gradient" android:elevation="8dp">
                <TextView android:text="Código QR de validación" android:textColor="#FFFFFF" android:fontFamily="serif" android:textStyle="bold" android:textSize="20sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <View android:layout_width="44dp" android:layout_height="3dp" android:background="@color/cesba_orange" android:layout_marginTop="12dp"/>
                <ImageView android:id="@+id/imgQR" android:layout_width="240dp" android:layout_height="240dp" android:background="@drawable/plate" android:padding="10dp" android:layout_marginTop="18dp" android:contentDescription="Código QR"/>
                <TextView android:text="Escanéalo para comprobar los datos de la credencial." android:textColor="#C9D6EE" android:textSize="13sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="24dp">
            <Button android:id="@+id/btnVoltear" android:text="Voltear" android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/cesba_blue" app:cornerRadius="16dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginEnd="5dp" android:backgroundTint="#DCE5F5"/>
            <Button android:id="@+id/btnValidar" android:text="Validar datos" android:textAllCaps="false" android:textStyle="bold" android:textColor="#FFFFFF" app:cornerRadius="16dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:layout_marginStart="5dp" android:backgroundTint="@color/cesba_blue"/>
        </LinearLayout>
        <Button android:id="@+id/btnTxt" android:text="Guardar como .txt" android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/cesba_blue" app:cornerRadius="16dp" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:backgroundTint="#DCE5F5"/>
        <Button android:id="@+id/btnNueva" android:text="Crear otra credencial" android:textAllCaps="false" android:textStyle="bold" android:textColor="#FFFFFF" app:cornerRadius="16dp" android:elevation="6dp" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:backgroundTint="@color/cesba_orange"/>
    </LinearLayout>
</LinearLayout>
</ScrollView>
