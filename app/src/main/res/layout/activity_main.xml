                    <View android:layout_width="90dp" android:layout_height="8dp" android:background="@drawable/bar" android:layout_marginTop="10dp"/>
                </LinearLayout>
                <View android:layout_width="46dp" android:layout_height="22dp" android:background="@drawable/chip_tipo"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp">
                <View android:layout_width="64dp" android:layout_height="8dp" android:background="@drawable/bar"/>
                <View android:layout_width="40dp" android:layout_height="8dp" android:background="@drawable/bar" android:layout_marginStart="22dp"/>
                <View android:layout_width="40dp" android:layout_height="8dp" android:background="@drawable/bar" android:layout_marginStart="22dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="26dp" android:paddingBottom="28dp">
            <TextView android:text="Un color para cada carrera" android:textColor="@color/text" android:fontFamily="serif" android:textStyle="bold" android:textSize="21sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:text="Tu credencial toma el color de tu carrera automáticamente." android:textColor="@color/muted" android:textSize="14sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" android:layout_marginEnd="-3dp">
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#F28C28"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#808080"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#D62828"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#B91C1C"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#E85D9E"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#F4C430"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#E5A11A"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#F7A8C4"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#7DBCE8"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#1769AA"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#35A853"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#C1121F"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#F28C28"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#6FA8DC"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#795548"/>
            <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="@drawable/chip_color" android:backgroundTint="#7B2CBF"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="30dp">
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/cesba_orange"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp">
                    <TextView android:text="Foto desde tu cámara" android:textColor="@color/text" android:textStyle="bold" android:textSize="15sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <TextView android:text="Tómala en el momento, sin subir archivos." android:textColor="@color/muted" android:textSize="13sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="18dp">
