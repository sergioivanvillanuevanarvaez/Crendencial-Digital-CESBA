                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/btnCrear" android:text="Crear mi credencial" android:textAllCaps="false" android:textStyle="bold" android:textSize="16sp" android:textColor="#FFFFFF" app:cornerRadius="18dp" android:elevation="6dp" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="34dp" android:backgroundTint="@color/cesba_orange"/>
        </LinearLayout>
    </LinearLayout>

    <!-- FORMULARIO -->
    <LinearLayout android:id="@+id/form" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_header">
            <View android:layout_width="180dp" android:layout_height="180dp" android:layout_gravity="end|top" android:layout_marginEnd="-60dp" android:layout_marginTop="-70dp" android:background="@drawable/circle_soft"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="20dp" android:paddingBottom="30dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="-12dp">
                    <ImageButton android:id="@+id/btnAtrasForm" android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Regresar" android:layout_width="48dp" android:layout_height="48dp"/>
                    <TextView android:text="Nueva credencial" android:textColor="#FFFFFF" android:fontFamily="serif" android:textStyle="bold" android:textSize="28sp" android:layout_marginStart="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:text="Completa tus datos para generar tu identificación." android:textColor="#C9D6EE" android:textSize="14sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginStart="40dp"/>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="28dp">
            <LinearLayout android:background="@drawable/card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <View android:layout_width="4dp" android:layout_height="18dp" android:background="@color/cesba_orange"/>
                <TextView android:text="Datos personales" android:textColor="@color/text" android:textStyle="bold" android:textSize="16sp" android:layout_marginStart="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="Nombre completo" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:boxStrokeColor="@color/box_stroke" app:hintTextColor="@color/cesba_blue" app:startIconDrawable="@drawable/ic_person" app:startIconTint="@color/muted">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords|textPersonName" android:textColor="@color/text" android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Correo electrónico" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:boxStrokeColor="@color/box_stroke" app:hintTextColor="@color/cesba_blue" app:startIconDrawable="@drawable/ic_mail" app:startIconTint="@color/muted">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCorreo" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:textColor="@color/text" android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:text="Tipo de usuario" android:textColor="@color/muted" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginStart="4dp"/>
            <Spinner android:id="@+id/spTipo" android:background="@drawable/outline" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp"/>
            </LinearLayout>

            <LinearLayout android:background="@drawable/card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <View android:layout_width="4dp" android:layout_height="18dp" android:background="@color/cesba_orange"/>
                <TextView android:text="Datos académicos" android:textColor="@color/text" android:textStyle="bold" android:textSize="16sp" android:layout_marginStart="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="Matrícula" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:boxStrokeColor="@color/box_stroke" app:hintTextColor="@color/cesba_blue" app:startIconDrawable="@drawable/ic_tag" app:startIconTint="@color/muted">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMatricula" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/text" android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:text="Carrera" android:textColor="@color/muted" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginStart="4dp"/>
            <Spinner android:id="@+id/spCarrera" android:background="@drawable/outline" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp"/>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="Semestre o cuatrimestre" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:boxStrokeColor="@color/box_stroke" app:hintTextColor="@color/cesba_blue" app:startIconDrawable="@drawable/ic_school" app:startIconTint="@color/muted">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSemestre" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textColor="@color/text" android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Grupo" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:boxStrokeColor="@color/box_stroke" app:hintTextColor="@color/cesba_blue" app:startIconDrawable="@drawable/ic_group" app:startIconTint="@color/muted">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etGrupo" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/text" android:textSize="15sp"/>
            </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout android:background="@drawable/card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <View android:layout_width="4dp" android:layout_height="18dp" android:background="@color/cesba_orange"/>
                <TextView android:text="Foto de la credencial" android:textColor="@color/text" android:textStyle="bold" android:textSize="16sp" android:layout_marginStart="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
                <ImageView android:id="@+id/imgFoto" android:contentDescription="Tu foto" android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="center" android:layout_marginTop="16dp"/>
                <Button android:id="@+id/btnFoto" android:text="Tomar foto" android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/cesba_blue" app:cornerRadius="16dp" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:backgroundTint="#DCE5F5"/>
            </LinearLayout>

            <Button android:id="@+id/btnGenerar" android:text="Generar credencial" android:textAllCaps="false" android:textStyle="bold" android:textSize="16sp" android:textColor="#FFFFFF" app:cornerRadius="18dp" android:elevation="6dp" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="24dp" android:backgroundTint="@color/cesba_orange"/>
        </LinearLayout>
    </LinearLayout>

    <!-- CREDENCIAL -->
    <LinearLayout android:id="@+id/credencial" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="-12dp">
            <ImageButton android:id="@+id/btnAtrasCred" android:src="@drawable/ic_back" android:tint="@color/cesba_blue" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:contentDescription="Regresar" android:layout_width="48dp" android:layout_height="48dp"/>
            <TextView android:id="@+id/tvTitulo" android:text="Tu credencial" android:textStyle="bold" android:fontFamily="serif" android:textSize="28sp" android:textColor="@color/text" android:layout_marginStart="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:text="Toca la credencial para voltearla y ver el código QR." android:textColor="@color/muted" android:textSize="14sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginStart="40dp"/>

        <FrameLayout android:id="@+id/flipContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp">
            <LinearLayout android:id="@+id/cardCredencial" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_gradient" android:elevation="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/imgLogoCredencial" android:layout_width="128dp" android:layout_height="56dp" android:src="@drawable/logo_cesba" android:scaleType="fitCenter" android:background="@drawable/plate" android:padding="6dp" android:contentDescription="Logo CESBA"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <TextView android:id="@+id/tvTipo" android:text="Alumno" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp" android:background="@drawable/chip_tipo" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <View android:layout_width="44dp" android:layout_height="3dp" android:background="@color/cesba_orange" android:layout_marginTop="18dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp">
                <ImageView android:id="@+id/imgCredencial" android:layout_width="96dp" android:layout_height="96dp" android:scaleType="centerCrop" android:background="@drawable/photo_ring" android:padding="3dp" android:contentDescription="Foto de la credencial"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="16dp">
                    <TextView android:id="@+id/tvNombre" android:textColor="#FFFFFF" android:fontFamily="serif" android:textStyle="bold" android:textSize="22sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvCarrera" android:textColor="#E3EAF8" android:textSize="13sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="22dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1.4" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:text="Matrícula" android:textColor="#B9C7E6" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvMatricula" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:text="Sem./Cuatri." android:textColor="#B9C7E6" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvSemestre" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:text="Grupo" android:textColor="#B9C7E6" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
